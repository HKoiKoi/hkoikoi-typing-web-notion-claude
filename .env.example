# 이 파일을 .env로 복사해 값을 채운다.
# shrimp-task-manager MCP 서버가 프로젝트 루트의 .env를 dotenv로 직접 읽으므로 셸 export는 필요 없다.

# shrimp 작업 데이터 저장 경로. 상대경로면 <프로젝트 루트>/shrimp_data/tasks.json,
# 절대경로면 하위에 프로젝트 폴더명이 한 단계 더 붙는다(<DATA_DIR>/<프로젝트명>/tasks.json).
DATA_DIR=shrimp_data
TEMPLATES_USE=ko
ENABLE_GUI=true

# 노션 연동 (Next.js 앱이 읽음. 로컬은 .env.local에 값을 채운다. 서버 전용이므로 NEXT_PUBLIC_ 접두사 금지)
# 노션 통합(Integration) 시크릿
NOTION_TOKEN=
# Passages DB(예문 목록)의 data source ID. DB 설정의 "Manage data sources" → "Copy data source ID" (DB ID와 다른 값)
NOTION_DATA_SOURCE_ID=
# Lines DB(줄 단위 본문)의 data source ID. 복사 방법은 위와 같고, 이 DB에도 통합을 연결해야 한다
NOTION_LINES_DATA_SOURCE_ID=
